# Database (Supabase PostgreSQL)
# Pooled connection for Prisma Client (Supavisor transaction mode, port 6543)
DATABASE_URL="postgres://[DB-USER].[PROJECT-REF]:[DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for Prisma Migrations (session mode, port 5432)
DIRECT_URL="postgres://[DB-USER].[PROJECT-REF]:[DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Session secret for HMAC-signed cookies (64-char hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your-64-char-hex-secret-here"

# Email (Resend)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=
FROM_EMAIL=reservations@quetzal.com
