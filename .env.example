# Database (Supabase PostgreSQL)
# Pooled connection for Prisma Client (Supavisor transaction mode, port 6543)
# sslmode=require is REQUIRED for production — never connect without SSL
DATABASE_URL="postgres://[DB-USER].[PROJECT-REF]:[DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Direct connection for Prisma Migrations (session mode, port 5432)
DIRECT_URL="postgres://[DB-USER].[PROJECT-REF]:[DB-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Session secret for HMAC-signed cookies (64-char hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your-64-char-hex-secret-here"

# Auth.js v5 (NextAuth)
# Generate AUTH_SECRET with: openssl rand -base64 64
AUTH_SECRET="your-auth-secret-here"
# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Cron job authentication — REQUIRED for /api/cron/expire-holds
# Generate with: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"

# Email (Resend)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=
FROM_EMAIL=reservations@quetzal.com

# PayPal — real checkout (server-only; NEVER prefix with NEXT_PUBLIC_)
# Sandbox credentials from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="your-paypal-sandbox-client-id"
# The client secret is server-only — it must never reach the client bundle.
PAYPAL_CLIENT_SECRET="your-paypal-sandbox-client-secret"
# "sandbox" (default) or "live"
PAYPAL_ENV="sandbox"
