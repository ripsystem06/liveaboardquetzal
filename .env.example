# Database URL for SQLite
DATABASE_URL="file:./dev.db"

# Session secret for HMAC-signed cookies (64-char hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="your-64-char-hex-secret-here"

# Admin password hash (salt:hash format, generated with crypto.scrypt)
# Generate with: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');c.scrypt('YOUR_PASSWORD',s,64,(e,k)=>{console.log(s+':'+k.toString('hex'))})"
ADMIN_PASSWORD_HASH=""

# Email (Resend)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=
FROM_EMAIL=reservations@quetzal.com
