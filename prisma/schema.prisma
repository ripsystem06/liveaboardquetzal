generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Reservation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  cruiseId      String
  cruiseName    String
  departureDate String
  route         String
  tier          String   // "basic" | "standard" | "premium"
  tierPrice     Int      // price in USD (whole dollars)
  guestCount    Int
  freeSpaces    Int      @default(0)
  paidSpaces    Int
  totalAmount   Int      // total in USD (whole dollars)
  paymentMethod String   // "paypal" | "bank_transfer"
  status        String   @default("pending_approval") // pending_approval, confirmed, expired, cancelled
  notes         String?
  crewRegistration CrewRegistration?
  paymentRecords PaymentRecord[]
  holdExpiry    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cruiseId, departureDate])  // for date blocking queries
  @@index([holdExpiry])               // for expiry checks
  @@index([userId])                   // for user reservation list
}

model PaymentRecord {
  id              String          @id @default(cuid())
  reservationId   String
  reservation     Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  provider        PaymentProvider @default(paypal)
  providerOrderId String          @unique
  status          PaymentStatus
  amountUsd       Int
  rawPayload      Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([reservationId])
}

model Cruise {
  id            String   @id @default(cuid())
  name          String
  departureDate String
  returnDate    String   @default("")
  route         String
  boat          String   @default("Quetzal")
  basicPrice    Int      // USD whole dollars
  standardPrice Int
  premiumPrice  Int
  dives         Int      @default(5)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String   @default("")
  status    String   @default("draft") // "draft" | "published"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  secondaryEmail String?
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  phone          String        @default("")
  isAdmin        Boolean       @default(false)
  reservations   Reservation[]
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  attempts   Int       @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  actorId     String?
  actorEmail  String?
  details     String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@index([action])
}

enum CrewRegistrationStatus {
  draft
  submitted
  approved
  rejected
}

enum CrewDocumentKind {
  passport_ine
  dive_cert
  dive_insurance
  nitrox_cert
}

enum CertificationLevel {
  open_water
  advanced
  rescue
  divemaster
  instructor
}

enum EquipmentSize {
  xs
  s
  m
  l
  xl
  xxl
}

enum BloodType {
  a_positive
  a_negative
  b_positive
  b_negative
  ab_positive
  ab_negative
  o_positive
  o_negative
}

enum PaymentProvider {
  paypal
}

enum PaymentStatus {
  pending
  completed
  failed
}

model CrewRegistration {
  id            String               @id @default(cuid())
  reservationId String               @unique
  reservation   Reservation          @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  status        CrewRegistrationStatus @default(draft)
  rejectReason  String?
  submittedAt   DateTime?
  // Section 6 (once, reservation-level)
  arrivalFlight   String
  arrivalDate     String
  arrivalTime     String
  departureFlight String
  departureDate   String
  departureTime   String
  hotelName       String
  hotelAddress    String
  guests          CrewRegistrationGuest[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status])
}

model CrewRegistrationGuest {
  id             String               @id @default(cuid())
  registrationId String
  registration   CrewRegistration     @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  guestIndex     Int
  // 1 personal
  fullName       String
  dateOfBirth    String
  nationality    String
  passportNumber String
  contactPhone   String
  contactEmail   String?
  // 2 diving
  certificationLevel    CertificationLevel
  logbookDives          Int?
  diveInsurancePolicyNo String
  isNitroxCertified     Boolean              @default(false)
  // 3 ballast/photo
  weightKg        Int?
  ballastKg       Int?
  photoEquipment  String?
  // 4 rental sizes
  bcdSize     EquipmentSize?
  wetsuitSize EquipmentSize?
  finsSize    String?
  maskSize    String?
  bootiesSize String?
  // 5 medical
  medicalLimitations  String?
  allergies           String?
  bloodType           BloodType?
  dietaryRestrictions String?
  // 7 emergency (2 contacts, required)
  ec1Name     String
  ec1Relation String
  ec1Phone    String
  ec2Name     String
  ec2Relation String
  ec2Phone    String
  documents   CrewRegistrationDocument[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([registrationId, guestIndex])
}

model CrewRegistrationDocument {
  id          String               @id @default(cuid())
  guestId     String
  guest       CrewRegistrationGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)
  kind        CrewDocumentKind
  storagePath String // object key; server-generated, never user input
  mimeType    String // application/pdf | image/jpeg | image/png
  sizeBytes   Int
  uploadedAt  DateTime             @default(now())

  @@unique([guestId, kind]) // one doc per kind → replace = upsert
}
