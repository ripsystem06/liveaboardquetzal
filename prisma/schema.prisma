generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Reservation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  cruiseId      String
  cruiseName    String
  departureDate String
  route         String
  tier          String   // "basic" | "standard" | "premium"
  tierPrice     Int      // price in USD (whole dollars)
  guestCount    Int
  freeSpaces    Int      @default(0)
  paidSpaces    Int
  totalAmount   Int      // total in USD (whole dollars)
  paymentMethod String   // "paypal" | "bank_transfer"
  status        String   @default("pending_approval") // pending_approval, confirmed, expired, cancelled
  notes         String?
  holdExpiry    DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cruiseId, departureDate])  // for date blocking queries
  @@index([holdExpiry])               // for expiry checks
  @@index([userId])                   // for user reservation list
}

model Cruise {
  id            String   @id @default(cuid())
  name          String
  departureDate String
  returnDate    String   @default("")
  route         String
  boat          String   @default("Quetzal")
  basicPrice    Int      // USD whole dollars
  standardPrice Int
  premiumPrice  Int
  dives         Int      @default(5)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String   @default("")
  status    String   @default("draft") // "draft" | "published"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String
  phone        String        @default("")
  isAdmin      Boolean       @default(false)
  reservations Reservation[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
